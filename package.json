{
  "name": "markdown2latex",
  "version": "1.3.0",
  "private": true,
  "description": "CleanMath - paste messy LLM math, get compilation-ready LaTeX. Normalizes delimiters, repairs align environments, wraps stray prose in \\text{}. 100% client-side.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "examples": "tsx scripts/generate-examples.ts",
    "logos": "node scripts/build-logos.mjs && node scripts/build-brand.mjs && node scripts/build-icon.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "katex": "0.19.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "homepage": "https://github.com/donghyuklee1/markdown2latex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghyuklee1/markdown2latex.git"
  },
  "bugs": {
    "url": "https://github.com/donghyuklee1/markdown2latex/issues"
  },
  "keywords": [
    "latex",
    "katex",
    "overleaf",
    "obsidian",
    "markdown",
    "math",
    "llm",
    "chatgpt",
    "claude",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9"
  }
}
