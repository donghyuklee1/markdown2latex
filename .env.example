# Copy to .env.local (never commit it). All optional.

# Site key for "Analyze with Gemini" (free: https://aistudio.google.com/apikey).
# Without it, visitors can still paste their own key in the app.
GEMINI_API_KEY=

# Pin a model instead of the newest Flash the key can use, e.g. gemini-2.5-flash.
GEMINI_MODEL=

# Shared analyses per day per server instance (protects the free quota).
GEMINI_DAILY_LIMIT=400

# Accounts (Google / GitHub sign-in, cloud history) - see docs/ACCOUNTS.md.
# Public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
