# Copy to .env.local (never commit it). All optional.

# There is no shared Gemini key: every visitor uses their own (AI mode).

# Accounts (Google / GitHub sign-in, cloud history) - see docs/ACCOUNTS.md.
# Public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive (signed-in users) - see docs/ACCOUNTS.md. Both public.
# The OAuth client id lets Drive reconnect in a popup after the sign-in token expires;
# the browser API key (restricted to the Picker API) enables "Browse all of Drive".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
